/-
  BlindPRF/Instance.lean — concrete models, so that no theorem in this development is vacuous.

  Every security theorem is stated for an abstract scalar field `F` and an abstract `F`-module
  `G` with a generator (`IsGenerator F g`).  This file exhibits two concrete models in which all
  of those hypotheses hold, and runs the protocol in them:

  1. `Toy`: `F = G = ZMod p` with generator `1`.  This is the additive group of integers mod `p`.
     It satisfies every algebraic hypothesis (and carries a non-degenerate bilinear "pairing",
     namely multiplication), but discrete logarithms in it are trivial, so it is useless as a
     cryptographic group.  Its role is purely logical: the hypotheses are satisfiable.

  2. `Schnorr`: a genuine multiplicative Diffie–Hellman group — the subgroup of order 11 of
     `(ℤ/23)ˣ` (the quadratic residues modulo the safe prime 23 = 2·11 + 1), with scalars
     `F = ZMod 11`.  It shows that the additive `Module` formulation used throughout is exactly
     the usual "cyclic group of prime order `q` with exponents mod `q`" setting, where `k • P`
     reads `P ^ k`.  The parameters are of course far too small to be secure; real deployments
     use a ~256-bit elliptic-curve group (e.g. ristretto255 or P-256, as in RFC 9497).

  The `#guard` lines are executed by the compiler when this file is built: they are runnable
  end-to-end tests of the protocol functions on concrete numbers.
-/
import BlindPRF.PublicVerify

namespace BlindPRF

/-! ### Model 1: the toy group `ZMod p` -/

namespace Toy

/-- In `ZMod p` (as a module over itself) the element `1` is a generator. -/
theorem isGenerator_one (p : ℕ) [Fact p.Prime] : IsGenerator (ZMod p) (1 : ZMod p) :=
  ⟨one_ne_zero, fun x => ⟨x, by simp⟩⟩

/-- A bilinear map on the toy group: multiplication. -/
def pairing (p : ℕ) [Fact p.Prime] : ZMod p →ₗ[ZMod p] ZMod p →ₗ[ZMod p] ZMod p :=
  LinearMap.mul (ZMod p) (ZMod p)

/-- The toy pairing is non-degenerate at the base point `1`: the hypothesis of the theorems in
`BlindPRF/PublicVerify.lean` is satisfiable. -/
theorem pairing_nondegenerate (p : ℕ) [Fact p.Prime] :
    Function.Injective fun x : ZMod p => pairing p x 1 := by
  intro x y h
  simpa [pairing] using h

instance fact101 : Fact (Nat.Prime 101) := ⟨by norm_num⟩

/-- A four-message toy hash table into `ZMod 101` (no entry is the identity `0`). -/
def demoHash : Fin 4 → ZMod 101 := ![3, 58, 77, 12]

/-- B's key. -/
def demoKey : ZMod 101 := 42

/-- A's blinding scalar (nonzero). -/
def demoCoin : (ZMod 101)ˣ := Units.mk0 17 (by decide)

-- A blinds message 2:  17 · 77 = 97  (mod 101)
#guard blind demoHash 2 demoCoin == 97
-- B evaluates:         42 · 97 = 34  (mod 101)
#guard evaluate demoKey (blind demoHash 2 demoCoin) == 34
-- A unblinds:          17⁻¹ · 34 = 2 (mod 101), which is the signature 42 · 77 = 2
#guard run demoHash demoKey 2 demoCoin == 2
#guard prf demoHash demoKey 2 == 2
#guard run demoHash demoKey 2 demoCoin == prf demoHash demoKey 2

/-- The general correctness theorem, specialised to the toy model. -/
example : run demoHash demoKey 2 demoCoin = prf demoHash demoKey 2 :=
  correctness demoHash demoKey 2 demoCoin

/-- Public verification, specialised to the toy model: the signature verifies, and only it. -/
example (σ : ZMod 101) :
    PublicVerify.verify (pairing 101) demoHash 1 (PublicVerify.publicKey 1 demoKey) 2 σ ↔
      σ = prf demoHash demoKey 2 :=
  PublicVerify.verify_iff (pairing 101) demoHash 1 (pairing_nondegenerate 101) demoKey 2 σ

end Toy

/-! ### Model 2: a real Diffie–Hellman group, the order-11 subgroup of `(ℤ/23)ˣ` -/

namespace Schnorr

instance fact23 : Fact (Nat.Prime 23) := ⟨by norm_num⟩
instance fact11 : Fact (Nat.Prime 11) := ⟨by norm_num⟩

/-- The element `4 = 2²` of `(ℤ/23)ˣ`. -/
def four : (ZMod 23)ˣ := Units.mk0 4 (by decide)

/-- `4` has multiplicative order dividing 11 modulo 23. -/
theorem four_pow : four ^ 11 = 1 := by
  apply Units.ext
  simp only [four, Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one]
  decide

theorem four_ne_one : four ≠ 1 := by
  intro h
  have := congrArg Units.val h
  simp only [four, Units.val_mk0, Units.val_one] at this
  exact absurd this (by decide)

/-- The subgroup of `(ℤ/23)ˣ` generated by `4`, written additively: group multiplication becomes
`+` and exponentiation `P ^ k` becomes scalar multiplication `k • P`. -/
abbrev QR : Type := Additive (Subgroup.zpowers four)

/-- Every element of the subgroup is killed by 11 (i.e. `P ^ 11 = 1`). -/
theorem eleven_nsmul (x : QR) : 11 • x = 0 := by
  obtain ⟨⟨y, hy⟩, rfl⟩ := Additive.ofMul.surjective x
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  rw [← ofMul_pow]
  apply congrArg Additive.ofMul
  apply Subtype.ext
  show (four ^ n) ^ 11 = 1
  rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, four_pow, one_zpow]

/-- Exponents live in `ZMod 11`: the subgroup is a vector space over the field `ZMod 11`. -/
instance : Module (ZMod 11) QR := AddCommGroup.zmodModule eleven_nsmul

/-- The generator `4`. -/
def gen : QR := Additive.ofMul ⟨four, Subgroup.mem_zpowers four⟩

/-- `4` generates the subgroup: it is a cyclic group of prime order 11, i.e. exactly the setting
`IsGenerator F g` assumed by the security theorems. -/
theorem isGenerator_gen : IsGenerator (ZMod 11) gen := by
  refine ⟨?_, ?_⟩
  · intro h
    apply four_ne_one
    have := congrArg (fun x : QR => ((Additive.toMul x : Subgroup.zpowers four) : (ZMod 23)ˣ)) h
    simpa [gen] using this
  · intro x
    obtain ⟨⟨y, hy⟩, rfl⟩ := Additive.ofMul.surjective x
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    refine ⟨(n : ZMod 11), ?_⟩
    rw [Int.cast_smul_eq_zsmul]
    rfl

/-- Read a group element back as a residue modulo 23. -/
def toZMod (x : QR) : ZMod 23 :=
  ((Additive.toMul x : Subgroup.zpowers four) : (ZMod 23)ˣ)

/-- Toy hash-to-group: message `i` is sent to `4 ^ (i + 1)` (never the identity for `i < 4`). -/
def demoHash : Fin 4 → QR := fun i => (i.val + 1 : ℕ) • gen

/-- B's key (an exponent mod 11). -/
def demoKey : ZMod 11 := 7

/-- A's blinding exponent (nonzero mod 11). -/
def demoCoin : (ZMod 11)ˣ := Units.mk0 3 (by decide)

-- H(m) for m = 2 is 4³ = 64 = 18 (mod 23)
#guard toZMod (demoHash 2) == 18
-- A sends H(m)^r = 4^(3·3) = 4^9
#guard toZMod (blind demoHash 2 demoCoin) == (4 : ZMod 23) ^ 9
-- B replies (H(m)^r)^k = 4^(9·7)
#guard toZMod (evaluate demoKey (blind demoHash 2 demoCoin)) == (4 : ZMod 23) ^ (9 * 7)
-- A's output is H(m)^k = 4^(3·7), the signature
#guard toZMod (run demoHash demoKey 2 demoCoin) == (4 : ZMod 23) ^ (3 * 7)
#guard toZMod (run demoHash demoKey 2 demoCoin) == toZMod (prf demoHash demoKey 2)

/-- The general correctness theorem, specialised to the real Diffie–Hellman group. -/
example : run demoHash demoKey 2 demoCoin = prf demoHash demoKey 2 :=
  correctness demoHash demoKey 2 demoCoin

end Schnorr

end BlindPRF
